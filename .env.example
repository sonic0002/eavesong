# Required when Eavesong listens beyond localhost (it does inside Docker).
EAVESONG_PASSWORD=change-me

# How often to check every source (minimum 5m).
EAVESONG_INTERVAL=30m

# Reply drafts: easiest to set on the Settings page. These are defaults.
# Provider: anthropic, deepseek, gemini, openai, or none.
EAVESONG_AI_PROVIDER=none
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# EAVESONG_AI_MODEL=claude-sonnet-5-5
#
# OpenAI, or a local model through Ollama:
# EAVESONG_AI_PROVIDER=openai
# EAVESONG_AI_BASE_URL=http://host.docker.internal:11434/v1
# EAVESONG_AI_MODEL=llama3.1
# OPENAI_API_KEY=

# Accounts: easiest to connect on the Settings page, where you can add several per platform.
# One of each can also be given here.
# BLUESKY_HANDLE=you.bsky.social
# BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# DEVTO_USERNAME=you
# DEVTO_API_KEY=
# GITHUB_TOKEN=
# STACKEXCHANGE_KEY=
# X_BEARER_TOKEN=
# X_USERNAME=
# EAVESONG_X_DAILY_CAP=100
# YOUTUBE_API_KEY=
# REDDIT_INBOX_FEED=https://www.reddit.com/message/inbox/.rss?feed=...&user=...
